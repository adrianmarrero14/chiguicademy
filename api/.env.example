# ---- App ----
NODE_ENV=development
PORT=3001
API_PREFIX=api
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SWAGGER_ENABLED=true

# ---- Database (PostgreSQL) ----
# Must match DB_* values in the root .env used by docker-compose
DATABASE_URL=postgresql://chiguicademy:chiguicademy@postgres:5432/chiguicademy?schema=public

# ---- Redis (queues, cache) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Object storage (MinIO locally, S3 in AWS) ----
# Must match MINIO_* values in the root .env used by docker-compose
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=chiguicademy
S3_ACCESS_KEY=chiguicademy
S3_SECRET_KEY=chiguicademy123
S3_FORCE_PATH_STYLE=true

# ---- Mail (Mailpit locally) ----
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="Chiguicademy <hola@chiguicademy.com>"
